# Copy to .env.local and fill in.
# Native multimodal engine (listens to the audio directly, no transcription step).
GEMINI_API_KEY=
# Any Gemini model that accepts audio input. The alias tracks Google's current Pro model.
GEMINI_MODEL=gemini-pro-latest

# Where projects, uploads, proxies and renders are stored (default: ./data).
# BINGKAI_DATA_DIR=./data
